# Copy to .env.local and fill in. Never commit real keys.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Upstox developer console: analytics token (read-only market data)
UPSTOX_ANALYTICS_TOKEN=

# Supabase project: Settings > API. Both are safe to expose to browsers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Read-only Gmail only. Google sign-in itself is set up in Supabase, not here.
# Google Cloud OAuth client (Web), Gmail API enabled, consent screen in Testing
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string; encrypts the Gmail cookie
AUTH_SECRET=
