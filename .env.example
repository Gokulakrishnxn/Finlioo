# Copy to .env.local and fill in. Never commit real keys.
# Full walkthrough: docs/gcp-setup.md

# --- Google Cloud project (accounts, sessions and data live in Firestore) ---
GCP_PROJECT_ID=
# Local only: `gcloud auth application-default login`, or point at the Firestore emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Vercel only: keyless access to Firestore (docs/gcp-setup.md). Leave empty locally.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=

# --- Sign in with Google (OAuth client, type "Web"; identity scopes only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# The public address when hosted, e.g. https://your-app.vercel.app (leave empty locally).
APP_URL=

# --- Firebase Auth (Firebase console > Project settings > Your apps). Safe to expose to browsers.
# When all four are set, sign-in goes through Firebase; otherwise straight through Google OAuth.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Account emails (send-only Gmail; Finlio never reads a mailbox) ---
# The sender account's refresh token for the gmail.send scope, and the From line.
GMAIL_SENDER_REFRESH_TOKEN=
MAIL_FROM="Finlio <you@gmail.com>"

# --- Finlio chat: Google AI Studio free keys (https://aistudio.google.com/apikey) ---
# The second key is used when the first is out of quota.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Optional. Defaults to gemini-3.5-flash-lite (small and low-cost); gemini-3.1-flash-lite is cheaper per answer.
# GEMINI_MODEL=

# Upstox developer console: analytics token (read-only market data)
UPSTOX_ANALYTICS_TOKEN=

# Encrypts money data before it reaches the database. Generate with: openssl rand -base64 32
# Keep a safe copy: if this key is lost, saved data can't be read. Use a different key per environment.
VAULT_MASTER_KEY=
